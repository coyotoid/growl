load "../std.grr"

def divisor? { % 0 = }
def fizzbuzz? { [3 divisor?] [5 divisor?] bi or }
def fizz { when: 3 divisor? ["Fizz" print]; }
def buzz { when: 5 divisor? ["Buzz" print]; }

def fizzbuzz1 {
  if: dup fizzbuzz?
    [[fizz] keep buzz "\n" print]
    [.];
}

def fizzbuzz {
  0 swap
  times: [1 + [fizzbuzz1] keep];
  drop
}

30 fizzbuzz
